color-link default "#ffffff,#0a0a0a"
color-link comment "#808080"
color-link identifier "#ffffff"
color-link constant "#ffffff"
color-link constant.string "#ffffff"
color-link statement "#ffffff"
color-link symbol "#ffffff"
color-link preproc "#ffffff"
color-link type "#ffffff"
color-link special "#ffffff"
color-link underlined "#ffffff"
color-link error "bold #ffffff,#999999"
color-link todo "bold #ffffff"
color-link hlsearch "#000000,#ffffff"
color-link statusline "#000000,#ffffff"
color-link tabbar "#ffffff,#1a1a1a"
color-link indent-char "#404040"
color-link line-number "#999999,#0a0a0a"
color-link current-line-number "#ffffff,#0a0a0a"
color-link cursor-line "#1a1a1a"
color-link color-column "#1a1a1a"
color-link selection "#ffffff,#666666"
color-link divider "#ffffff,#0a0a0a"
color-link gutter-error "#ffffff"
color-link gutter-warning "#ffffff"
color-link match-brace "#000000,#ffffff"
color-link message "#ffffff,#0a0a0a"
color-link error-message "#ffffff,#999999"
